# Server & Environment
APP_ENV=production
HOST=127.0.0.1
PORT=8610
CORS_ORIGINS=http://localhost:8611,http://127.0.0.1:8611

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/music.db

# Authentication & JWT (APP_JWT_SECRET is required, min 32 chars)
APP_JWT_SECRET=your-32-char-or-more-random-jwt-secret-here
APP_JWT_SECRET_PREVIOUS=
JWT_ISSUER=music-app
JWT_AUDIENCE=music-app-api
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=10
AUDIO_TICKET_TTL_SECONDS=7200

# Registration & User Limits
ALLOW_REGISTRATION=true
REGISTRATION_INVITE_CODE=
MAX_USERS=100

# Security & Password Hashing
ARGON2_MEMORY_KB=47104
ARGON2_TIME_COST=1
ARGON2_PARALLELISM=1
HASH_CONCURRENCY=2
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900
TRUST_FORWARDED_FOR=false

# Cache
REDIS_URL=

# Bandwidth Guard & Streaming
MAX_CONCURRENT_STREAMS=20
RATE_LIMIT_PER_MIN=120
DAILY_AUDIO_MB_PER_USER=68266
MONTHLY_AUDIO_GB_GLOBAL=2048

# Cache TTLs (seconds)
STREAM_URL_TTL=3000
SEARCH_TTL=900
META_TTL=86400

# User Data Limits (Phase 3)
MAX_PLAYLISTS_PER_USER=200
MAX_TRACKS_PER_PLAYLIST=5000
HISTORY_MAX_ITEMS_PER_USER=10000
HISTORY_RETENTION_DAYS=365

# Discovery & Upstream Limiter (Phase 4)
YTMUSIC_LOCATION=US
YTMUSIC_LANGUAGE=en
YTM_MAX_CONCURRENT_UPSTREAM=4
YTM_MAX_UPSTREAM_PER_MIN=60
TTL_HOME=1800
TTL_CHARTS=3600
TTL_MOODS=86400
TTL_ALBUM=21600
TTL_ARTIST=21600
TTL_PLAYLIST=3600
TTL_LYRICS=604800
TTL_SUGGEST=600
TTL_RADIO=900
STALE_EXTRA_TTL=86400

# Downloads & Storage Limits (Phase 5)
DAILY_DOWNLOAD_MB_PER_USER=1000
MAX_DOWNLOAD_TRACK_MB=80
MAX_CONCURRENT_DOWNLOADS_PER_USER=2
MAX_CONCURRENT_DOWNLOADS_GLOBAL=4


